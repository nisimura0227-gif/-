# 管理者ログインのパスワード（本番運用前に必ず変更してください）
ADMIN_PASSWORD=admin123

# 上記パスワードを使ったログインセッションの署名に使う秘密文字列
# 適当な長いランダム文字列に変更してください（例: openssl rand -hex 32）
SESSION_SECRET=change-this-to-a-random-secret-string

# --- 本番（Vercelなど）で使う場合 ---
# Upstash Redis（Vercelの Storage タブから無料で追加可能）の接続情報。
# この2つを設定すると、データの保存先が自動的にRedisに切り替わります。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- 永続ディスクが使えるホスティング先（Railwayなど）を使う場合のみ ---
# データ保存先フォルダ（省略可）。ボリュームのマウントパスを設定してください。
# 例: DATA_DIR=/app/data
# UPSTASH_REDIS_REST_URL / TOKEN が未設定の場合、これも未設定ならプロジェクト内の
# data フォルダに保存されます（ローカル動作確認用のデフォルト）。
# DATA_DIR=

# --- 公式LINE連携（任意。設定しなくてもサイトの注文・管理機能は動きます） ---
# 詳しい取得手順は LINE設定用/公式LINE_MessagingAPI・LIFF設定手順.md を参照してください。

# Messaging APIのチャネルアクセストークン（長期）
# LINE_CHANNEL_ACCESS_TOKEN=

# Messaging APIのチャネルシークレット（Webhookの署名検証に使用）
# LINE_CHANNEL_SECRET=

# LIFFアプリID（利用者・管理者のLINEアカウントを紐付けるために使用。クライアントに公開されます）
# NEXT_PUBLIC_LIFF_ID=

# サイトの公開URL（LIFF未設定時のリンク生成・通知メッセージ内リンクに使用）
# 例: NEXT_PUBLIC_SITE_URL=https://bento-order-app-weld.vercel.app
# NEXT_PUBLIC_SITE_URL=

# 定時通知（毎朝6:30のリマインド／前日15:00の締切サマリー）を実行するCronからの
# リクエストを認証するためのランダムな文字列（例: openssl rand -hex 32）
# CRON_SECRET=
